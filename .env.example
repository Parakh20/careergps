# Anthropic Claude (server-side only, used by api/generate-*.js)
# ANTHROPIC_API_KEY is also accepted. Without a key the app uses its built-in demo generator.
CLAUDE_API_KEY=your_claude_api_key

# Supabase (Project Settings -> API). Optional: without these, accounts and saved plans are disabled.
# The anon key is public by design; access is enforced by row-level security policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
